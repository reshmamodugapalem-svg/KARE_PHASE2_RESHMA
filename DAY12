// HYBRID INHERITANCE
class Grandfather{
    void gen1(){
        System.out.println("Money");
    }
}
class Father extends Grandfather{
    void gen21(){
        System.out.println("Gold");
    }
}
class Mother extends Father{
    void gen22(){
        System.out.println("Silver");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Diamond");
    }
}
class Main{
    public static void main(String[] args){
        Son s = new Son();
        s.gen3();
        s.gen21();
        s.gen1();
        Mother m = new Mother();
        m.gen22();
        m.gen21();
    }
}

// WRITE A JAVA PROGRAM TO CHECK THE SPECIFIC NUMBER IS SQUARE OR NOT BY USING FUNCTION WITH NO ARGUMENT NO RETURNTYPE
import java.util.*;
class Main{
    void ps(){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int flag = 0,i;
        for(i=1;i<=n/2;i++){
            if(i*i == n){
                flag=1;
                System.out.print("Perfect Square");
                break;
            }
        }
        if(flag == 0)
        System.out.print("Not a perfect square");
    }
    public static void main(String[] args){
        Main m = new Main();
        m.ps();
    }
}

