// Write a java program to count the no.of.digits in the given Number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int c=0;
        while(n!=0){
            n=n/10;
            c++;
        }
        System.out.print("No of digits: " + c);
    }
}

// Write a java program t0 reverrse the given digits using right side formation
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int d,ans=0;
        while(n!=0){
            d=n%10;
            ans=ans*10+d;
            n=n/10;
        }
        System.out.print("Reverse Number: " + ans);
    }
}

// Write a java program t0 count the odd,even digits in the given number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ec=0,oc=0,d;
        while(n!=0){
            d=n%10;
            if(d%2==0)
            ec++;
            else
            oc++;
            n=n/10;
        }
        System.out.print("Odd digit count: " + oc);
        System.out.print("Even digit count: " + ec);
    }
}

// Write a java program to count the prime digits in the given number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int d,c=0;
        while(n!=0){
            d=n%10;
            if(d==2||d==3||d==5||d==7)
            c++;
            n=n/10;
        }
        System.out.print("Prime Number: " + c);
    }
}

