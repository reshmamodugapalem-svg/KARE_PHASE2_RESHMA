// Palindrome Number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int d,temp=n,rev=0;
        while(n!=0){
            d=n%10;
            rev=rev*10+d;
            n=n/10;
        }
        if(temp==rev)
        System.out.print("Palindrome Number");
        else
        System.out.print("Not a palindrome number");
    }
}
