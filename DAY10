// WRITE A JAVA PROGRAM TO CREATE AND DISPLAY THE 2D ARRAY ELEMETS
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of rows:");
        int r = sc.nextInt();
        System.out.println("Enter no of columns:");
        int c = sc.nextInt();
        int arr[][] = new int[r][c];
        int i,j;
        System.out.print("Enter array elements:");
        for(i=0;i<r;i++){
            for(j=0;j<c;j++){
                arr[i][j]=sc.nextInt();
            }
        }
        for(i=0;i<r;i++,System.out.println()){
            for(j=0;j<c;j++){
                System.out.print(arr[i][j] + " ");
            }
        }
    }
}

// WRITE A JAVA PROGRAM FOR THE SUM OF ARRAY ELEMENTS
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of rows:");
        int r = sc.nextInt();
        System.out.println("Enter no of columns:");
        int c = sc.nextInt();
        int arr[][] = new int[r][c];
        int i,j,sum=0;
        System.out.print("Enter array elements:");
        for(i=0;i<r;i++){
            for(j=0;j<c;j++){
                arr[i][j]=sc.nextInt();
                sum = sum+arr[i][j];
            }
        }
        System.out.print("SUM OF ELEMENTS : " + sum);
    }
}

