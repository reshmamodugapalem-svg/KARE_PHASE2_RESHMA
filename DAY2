// i/p                    o/p
// 2 2                  2 AND 2 ARE EQUAL
// 1 54                 1 AND 54 ARE NOT EQUAL
package CSE;
import java.util.*;
public class MAIN {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt();
		int b = sc.nextInt();
		if(a == b)
			System.out.println(a + " AND " + b + " ARE EQUAL");
		else
			System.out.println(a + " AND " + b + " ARE NOT EQUAL");
	}
}

