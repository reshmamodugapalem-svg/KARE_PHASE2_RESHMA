// ARRAYLIST USING USER INPUT
import java.util.*;
class Main{
    public static void main(String[] args){
     ArrayList<Integer> obj = new ArrayList<Integer>();
     Scanner s = new Scanner(System.in);
     int n = s.nextInt();
     int i;
     for(i=0;i<n;i++)
     obj.add(s.nextInt());
     System.out.print(obj);
    }
}

