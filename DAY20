     int ind = sc.nextInt();
     int val = sc.nextInt();
     obj.add(ind,val);
     System.out.println(obj);
     System.out.println("Insert first position");
     System.out.println("Enter first element to be add");
     int d = sc.nextInt();
     obj.addFirst(d);
     System.out.print(obj);
