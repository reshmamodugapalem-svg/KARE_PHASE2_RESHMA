// LINKEDLIST WITH INBUILT METHODS
import java.util.*;
class Main{
    public static void main(String[] args){
     LinkedList obj = new LinkedList();
     int i;
     Scanner sc = new Scanner(System.in);
     int n = sc.nextInt();
     for(i=0;i<n;i++)
     obj.add(sc.nextInt());
     System.out.print("LinkedList Elements");
     System.out.println(obj);
     int ind = sc.nextInt();
     int val = sc.nextInt();
     obj.add(ind,val);
     System.out.println(obj);
     System.out.println("Insert first position");
     System.out.println("Enter first element to be add");
     int d = sc.nextInt();
     obj.addFirst(d);
     System.out.print(obj);
     System.out.println("Insert last position");
     System.out.println("Enter last element to be add");
     d = sc.nextInt();
     obj.addLast(d);
     System.out.print(obj);
    }
}

