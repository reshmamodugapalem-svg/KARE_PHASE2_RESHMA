// STRONG NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n;
        int fact,sum=0,d;
        while(n!=0){
            fact=1;
            d=n%10;
            for(int i = 1; i <= d; i++)
            fact = fact * i;
            sum = sum+fact;
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Strong Number");
        else
        System.out.print("Not a strong number");
    }
}

// ARMSTRONG NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, c=0;
        int sum=0,d;
        while(n!=0){
            n=n/10;
            c++;
        }
        n=temp;
        while(n!=0){
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Armstrong Number");
        else
        System.out.print("Not a armstrong number");
    }
}

// ADAM NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sn = n*n;
        int rn=0,srn,ans=0,d;
        while(n!=0){
            d = n%10;
            rn = rn*10+d;
            n=n/10;
        }
        srn = rn * rn;
        while(srn!=0){
            d=srn%10;
            ans=ans*10+d;
            srn=srn/10;
        }
        if(sn == ans)
        System.out.print("Adam Number");
        else
        System.out.print("Not a adam number");
    }
}

