// WRITE THE JAVA PROGRAM TO FIND THE SUM OF ARRAY  ELEMENTS
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(); // 5
        int arr[] = new int[n]; // 1 10 2 5 3
        int i,sum=0;
        for(i=0;i<n;i++){
        arr[i]=sc.nextInt();
        sum=sum+arr[i];
        }
        System.out.print("Sum of Array Elements: " + sum);
    }
}

// WRITE THE JAVA PROGRAM TO FIND THE ODD, EVEN ELEMENT COUNT IN THE GIVEN ARRAY
//   I/P                    O/p
//    5
//  10 2 34 5 23         Odd Element Count: 2
//                       Even Element Count: 3
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n]; 
        int i,ec=0,oc=0;
        for(i=0;i<n;i++){
        arr[i]=sc.nextInt();
        if(arr[i]%2==0)
            ec++;
        else
            oc++;
        }
        System.out.println("Even Elements Count:  " + ec++);
        System.out.println("Odd Elements Count: " + oc++);
    }
}

