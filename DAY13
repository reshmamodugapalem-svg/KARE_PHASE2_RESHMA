// Queue Using ArrayDeque – Delete Front Element
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        Queue<Integer> obj = new ArrayDeque<>();
        System.out.print("Enter number of elements: ");
        int n = s.nextInt();
        System.out.println("Enter elements:");
        for (int i = 0; i < n; i++) {
            obj.offer(s.nextInt());
        }
        System.out.println("Queue: " + obj);
        System.out.println("Deleted element: " + obj.poll());
        System.out.println("Queue after deletion: " + obj);
    }
}

