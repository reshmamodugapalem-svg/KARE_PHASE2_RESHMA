// Find Common Elements Between Two Sets
Uses retainAll().
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        Set<Integer> obj1 = new HashSet<>();
        Set<Integer> obj2 = new HashSet<>();
        System.out.print("Enter number of elements in Set 1: ");
        int n1 = s.nextInt();
        System.out.println("Enter Set 1 elements:");
        for (int i = 0; i < n1; i++) {
            obj1.add(s.nextInt());
        }
        System.out.print("Enter number of elements in Set 2: ");
        int n2 = s.nextInt();
        System.out.println("Enter Set 2 elements:");
        for (int i = 0; i < n2; i++) {
            obj2.add(s.nextInt());
        }
        obj1.retainAll(obj2);
        System.out.println("Common elements: " + obj1);
    }
}

