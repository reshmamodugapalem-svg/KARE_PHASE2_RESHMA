// WRITE A JAVA PROGRAM TO FIND THE VOWELS COUNT IN THE GIVEN STRING
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine().toUpperCase();
        int c=0;
        for(char ch:s.toCharArray()){
        if(ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U')
        c++;
        }
        System.out.print("Total Number of VOWELS: " + c);
    }
}

// WRITE A JAVA PROGRAM TO FIND THE CONSONANTS COUNT IN THE GIVEN STRING
