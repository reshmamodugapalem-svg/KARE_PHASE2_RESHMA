// WRITE A JAVA PROGRAM TO PRINT LENGTH OF THE STRING WITHOUT USING IN-BUILT METHOD
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        int c = 0;
        for(char ch:s.toCharArray())
        c++;
        System.out.print(c);
    }
}

